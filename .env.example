# =============================================================
# 在线订餐系统 · 生产环境变量模板
# 使用方法：cp .env.example .env  然后填写各项真实值
# 警告：.env 文件绝不可提交到 Git 仓库！
# =============================================================

# ── Flask 核心 ────────────────────────────────────────────────
# 生产环境必须设置为随机长字符串，可用以下命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机64位字符串

FLASK_ENV=production

# ── MySQL 数据库 ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=请替换为强密码_至少16位含大小写数字特殊字符
MYSQL_DATABASE=meituan_waimai
MYSQL_USER=meituan_user
MYSQL_PASSWORD=请替换为强密码_至少16位含大小写数字特殊字符
MYSQL_PORT=3307

# ── Redis ─────────────────────────────────────────────────────
# 设置后 docker-compose 会自动为 Redis 启用 requirepass
REDIS_PASSWORD=请替换为Redis访问密码
# REDIS_URL 会自动拼接密码，格式固定如下（替换密码部分）：
REDIS_URL=redis://:请替换为Redis访问密码@redis:6379/0

# ── Web 服务端口（服务器上 Nginx 代理到此端口，不对外直接暴露）──
WEB_PORT=5000

# ── 首次空库初始化：管理员账号（Docker / entrypoint 使用）────────────────
# 生产环境（FLASK_ENV=production）首次启动前必填；须满足密码策略（长度 8～128、字母+数字、zxcvbn 阈值）。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=请替换为强密码_满足密码策略
INITIAL_ADMIN_EMAIL=admin@你的域名.com
INITIAL_ADMIN_PHONE=13800138000
# 是否在空库时创建演示用户 testuser（生产建议 0；开发可省略，由 FLASK_ENV=development 自动创建）
SEED_DEMO_USERS=0

# ── 高德地图 API（P1 阶段接入）────────────────────────────────
# 在 https://lbs.amap.com/ 申请 Web 端 JS API Key
AMAP_JS_KEY=

# ── 微信支付（P2 阶段接入）────────────────────────────────────
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=https://你的域名/api/v1/payment/wechat/notify

# ── 支付宝（P2 阶段接入）──────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://你的域名/api/v1/payment/alipay/notify

# ── 短信服务（P2 阶段接入）────────────────────────────────────
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
